---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={['content-card', 'project-card', { featured }]}>
  <a class="card-media" href={`/proyecto/${project.id}/`} tabindex="-1" aria-hidden="true">
    {project.data.featuredImage ? (
      <Image
        src={project.data.featuredImage}
        alt={project.data.featuredImageAlt}
        widths={[480, 768, 1200]}
        sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 50vw, 100vw'}
        loading="lazy"
      />
    ) : (
      <span class="media-placeholder" aria-hidden="true">DA</span>
    )}
  </a>
  <div class="card-body">
    <p class="card-kicker">{project.data.category}</p>
    <h3><a href={`/proyecto/${project.id}/`}>{project.data.title}</a></h3>
    <p>{project.data.summary}</p>
    <a class="text-link" href={`/proyecto/${project.id}/`}>Ver proyecto <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
</article>

<style>
  .content-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .content-card:hover {
    border-color: #c8c8c8;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.07);
    transform: translateY(-3px);
  }

  .card-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--surface-strong);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .content-card:hover .card-media img {
    transform: scale(1.025);
  }

  .media-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background-image: linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
    color: #bbb;
    font-size: 2rem;
    font-weight: 700;
  }

  .card-body {
    padding: 1.4rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    color: #858585;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .card-kicker {
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-body h3 {
    margin: 0;
    font-size: clamp(1.18rem, 2vw, 1.5rem);
    font-weight: 590;
    letter-spacing: -0.035em;
    line-height: 1.18;
  }

  .card-body h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .content-card {
    position: relative;
  }

  .card-body > p:not(.card-kicker) {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.85rem 0 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .card-body .text-link {
    position: relative;
    z-index: 2;
  }
</style>
