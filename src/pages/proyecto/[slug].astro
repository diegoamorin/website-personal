---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowUpRight, CircleOff } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasRealTestimonial = project.data.client.name !== 'Nombre del cliente';
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  canonicalPath={`/proyecto/${project.id}/`}
  image={project.data.featuredImage}
  imageAlt={project.data.featuredImageAlt}
>
  <article>
    <header class="project-header section">
      <div class="container">
        <a class="back-link" href="/proyectos/"><ArrowLeft size={16} aria-hidden="true" /> Volver a proyectos</a>
        <div class="project-heading-grid">
          <div>
            <p class="eyebrow">{project.data.category}</p>
            <h1>{project.data.title}</h1>
            <p class="project-summary">{project.data.summary}</p>
          </div>
          <dl class="project-facts">
            <div><dt>Inicio</dt><dd>{formatDate(project.data.startedAt)}</dd></div>
            <div><dt>Tecnologías</dt><dd>{project.data.technologies.join(', ') || 'Por completar'}</dd></div>
            <div>
              <dt>Proyecto</dt>
              <dd>
                {project.data.projectUrlStatus === 'active' && project.data.projectUrl ? (
                  <a href={project.data.projectUrl}>Visitar web <ArrowUpRight size={15} aria-hidden="true" /></a>
                ) : (
                  <span class="project-offline"><CircleOff size={15} aria-hidden="true" /> Ya no está disponible</span>
                )}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    {project.data.featuredImage && (
      <div class="project-cover container-wide">
        <Image
          src={project.data.featuredImage}
          alt={project.data.featuredImageAlt}
          widths={[768, 1200, 1600]}
          sizes="(min-width: 1200px) 1200px, 100vw"
          loading="eager"
        />
      </div>
    )}

    <Prose class="project-content container-narrow">
      <Content />
    </Prose>

    {hasRealTestimonial && (
      <section class="project-testimonial section">
        <div class="container-narrow">
          <p class="eyebrow eyebrow-light">En palabras del cliente</p>
          <blockquote>“{project.data.client.testimonial}”</blockquote>
          <div class="project-client">
            {project.data.client.image && (
              <Image src={project.data.client.image} alt="" width={56} height={56} loading="lazy" />
            )}
            <p><strong>{project.data.client.name}</strong><span>{project.data.client.role}</span></p>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Project */
  .project-header {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .project-heading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .project-heading-grid h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 610;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }

  .project-summary {
    max-width: 680px;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
  }

  .project-facts {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .project-facts > div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
  }

  .project-facts dt {
    color: var(--muted);
  }

  .project-facts dd {
    margin: 0;
    font-weight: 560;
  }

  .project-facts a,
  .project-offline {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .project-offline {
    color: #858585;
    font-weight: 470;
  }

  .project-content {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .project-content :global(img) {
    max-width: min(100%, 1100px);
  }

  .project-testimonial blockquote {
    margin: 1.5rem 0 2.5rem;
    color: #eee;
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1.25;
  }

  .project-client {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .project-client img {
    width: 56px;
    height: 56px;
  }

  .project-client p,
  .project-client strong,
  .project-client span {
    display: block;
    margin: 0;
  }

  .project-client strong {
    font-size: 0.9rem;
  }

  .project-client span {
    margin-top: 0.15rem;
    color: #858585;
    font-size: 0.76rem;
  }

  .project-cover {
    overflow: hidden;
    margin-top: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .project-cover img {
    width: 100%;
    max-height: 780px;
    object-fit: cover;
  }

  .project-testimonial {
    background: #0a0a0a;
    color: #fff;
  }

  @media (max-width: 760px) {
    .project-heading-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
