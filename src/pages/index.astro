---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, Check } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import heroImage from '../assets/site/diego-hero.jpg';
import aboutImage from '../assets/site/diego-about.jpg';
import { brands, testimonials } from '../data/site';
import { sortByPublishedAt } from '../lib/format';

const posts = sortByPublishedAt(await getCollection('blog')).slice(0, 3);
const projects = sortByPublishedAt(await getCollection('projects')).slice(0, 3);
---

<BaseLayout
  title="Diego Amorin"
  description="Diseño y desarrollo sitios web a medida, construidos desde la estrategia y pensados para hacer crecer tu negocio."
  image={heroImage}
>
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Disponible para nuevos proyectos</p>
        <h1>Creación de<br /><span>Sitios web</span><br />a medida</h1>
        <p class="hero-description">
          No improviso. Analizo tu negocio y a tu competencia para darte la web que necesitas.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="mailto:hola@diegoamorin.com">
            Cuéntame tu proyecto <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href="/proyectos/">
            Ver proyectos <ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </div>
        <ul class="hero-features" aria-label="Características del servicio">
          <li><Check size={15} aria-hidden="true" /> Estrategia</li>
          <li><Check size={15} aria-hidden="true" /> Diseño</li>
          <li><Check size={15} aria-hidden="true" /> Desarrollo</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="hero-grid-lines" aria-hidden="true"></div>
        <div class="hero-image-frame">
          <Image
            src={heroImage}
            alt="Diego Amorin, desarrollador web"
            widths={[640, 960, 1280]}
            sizes="(min-width: 900px) 46vw, 100vw"
            loading="eager"
          />
          <span class="hero-caption">Lima, Perú <span>GMT−5</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-section" aria-labelledby="brands-title">
    <div class="container">
      <p id="brands-title" class="brand-label">He creado webs para marcas de distintos países</p>
      <div class="brand-grid">
        {brands.map((brand) => (
          <div class="brand-item">
            <Image src={brand.image} alt={brand.name} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="about-image-wrap">
          <Image
            src={aboutImage}
            alt="Retrato de Diego Amorin"
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 38vw, 100vw"
            loading="lazy"
          />
        </div>
        <p class="image-note">Desarrollador web freelance</p>
      </div>
      <div class="about-copy">
        <p class="eyebrow">Sobre mí</p>
        <h2>Diseño con intención.<br />Desarrollo con criterio.</h2>
        <p class="lead">
          Soy Diego Amorin, desarrollador web de Perú. Colaboro con marcas de España, Perú,
          México y Chile para convertir ideas y necesidades de negocio en productos digitales claros.
        </p>
        <p>
          Cuento con más de 6 años de experiencia creando sitios con WordPress, Astro, Next.js y
          NestJS. Me interesa que cada decisión visual y técnica tenga una razón: comunicar mejor,
          cargar rápido y facilitar el siguiente paso del usuario.
        </p>
        <div class="about-stat">
          <strong>6+</strong>
          <span>años creando<br />experiencias web</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bordered" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Trabajo reciente</p>
          <h2 id="projects-title">Proyectos seleccionados</h2>
        </div>
        <a class="text-link" href="/proyectos/">Ver todos <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="project-grid home-project-grid">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section testimonials-section" aria-labelledby="testimonials-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-light">Confianza</p>
          <h2 id="testimonials-title">Ellos confiaron en mí.</h2>
        </div>
        <p class="section-intro">Relaciones de trabajo claras, cercanas y orientadas a resultados.</p>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((testimonial) => (
          <figure class="testimonial-card">
            <blockquote>“{testimonial.quote}”</blockquote>
            <figcaption>
              <Image src={testimonial.image} alt="" width={48} height={48} loading="lazy" />
              <span><strong>{testimonial.name}</strong><small>{testimonial.role}</small></span>
              <a href={`/proyecto/${testimonial.projectSlug}/`} aria-label={`Ver proyecto relacionado con ${testimonial.name}`}>
                <ArrowUpRight size={17} aria-hidden="true" />
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="articles-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Desde el blog</p>
          <h2 id="articles-title">Notas sobre diseño y código</h2>
        </div>
        <a class="text-link" href="/blog/">Ver el blog <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="article-grid">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
