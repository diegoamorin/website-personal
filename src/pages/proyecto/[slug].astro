---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowUpRight, CircleOff } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasRealTestimonial = project.data.client.name !== 'Nombre del cliente';
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  canonicalPath={`/proyecto/${project.id}/`}
  image={project.data.featuredImage}
  imageAlt={project.data.featuredImageAlt}
>
  <article>
    <div class="project-layout container-wide">
      <dl class="project-facts">
        <div><dt>Inicio</dt><dd>{formatDate(project.data.startedAt)}</dd></div>
        <div><dt>Tecnologías</dt><dd>{project.data.technologies.join(', ') || 'Por completar'}</dd></div>
        <div>
          <dt>Proyecto</dt>
          <dd>
            {project.data.projectUrlStatus === 'active' && project.data.projectUrl ? (
              <a href={project.data.projectUrl}>Visitar web <ArrowUpRight size={15} aria-hidden="true" /></a>
            ) : (
              <span class="project-offline"><CircleOff size={15} aria-hidden="true" /> Ya no está disponible</span>
            )}
          </dd>
        </div>
        <div><dt>Tipo</dt><dd>{project.data.category}</dd></div>
      </dl>
      <div class="project-main">
        <h1>{project.data.title}</h1>
        {project.data.featuredImage && (
          <div class="project-cover">
            <Image
              src={project.data.featuredImage}
              alt={project.data.featuredImageAlt}
              widths={[480, 768, 1200]}
              sizes="(min-width: 980px) 780px, 100vw"
              loading="eager"
            />
          </div>
        )}
        <Prose>
          <Content />
        </Prose>
      </div>
    </div>

    {hasRealTestimonial && (
      <section class="project-testimonial section">
        <div class="container-narrow">
          <p class="eyebrow eyebrow-light">En palabras del cliente</p>
          <blockquote>“{project.data.client.testimonial}”</blockquote>
          <div class="project-client">
            {project.data.client.image && (
              <Image src={project.data.client.image} alt="" width={56} height={56} loading="lazy" />
            )}
            <p><strong>{project.data.client.name}</strong><span>{project.data.client.role}</span></p>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Project */
  .project-main > h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 0.98;
    margin-bottom: 2rem;
  }

  .project-facts {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    align-self: start;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .project-facts > div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
  }

  .project-facts dt {
    color: var(--muted);
  }

  .project-facts dd {
    min-width: 0;
    margin: 0;
    font-weight: 560;
    overflow-wrap: anywhere;
  }

  .project-facts a,
  .project-offline {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .project-offline {
    color: #858585;
    font-weight: 470;
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, var(--container-narrow)) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .project-main {
    min-width: 0;
  }

  .project-testimonial blockquote {
    margin: 1.5rem 0 2.5rem;
    color: #eee;
    font-size: clamp(1.6rem, 4vw, 2rem);
    letter-spacing: -0.045em;
    line-height: 1.25;
  }

  .project-client {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .project-client img {
    width: 56px;
    height: 56px;
  }

  .project-client p,
  .project-client strong,
  .project-client span {
    display: block;
    margin: 0;
  }

  .project-client strong {
    font-size: 0.9rem;
  }

  .project-client span {
    margin-top: 0.15rem;
    color: #858585;
    font-size: 0.76rem;
  }

  .project-cover {
    overflow: hidden;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .project-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-testimonial {
    background: #0a0a0a;
    color: #fff;
  }

  @media (max-width: 980px) {
    .project-layout {
      grid-template-columns: minmax(170px, 220px) minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .project-layout {
      display: block;
    }

    .project-facts {
      position: static;
      margin-bottom: 2.5rem;
    }
  }
</style>
