---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import heroImage from '../assets/site/diego-hero.jpg';
import aboutImage from '../assets/site/diego-about.jpg';
import { brands, testimonials } from '../data/site';
import { sortByPublishedAt } from '../lib/format';

const posts = sortByPublishedAt(await getCollection('blog')).slice(0, 3);
const projects = sortByPublishedAt(await getCollection('projects')).slice(0, 4);
---

<BaseLayout
  title="Diego Amorin"
  description="Diseño y desarrollo sitios web a medida, construidos desde la estrategia y pensados para hacer crecer tu negocio."
  image={heroImage}
>
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <!-- <p class="eyebrow"><span class="status-dot"></span> Disponible para nuevos proyectos</p> -->
        <h1>Creación de<br />Sitios web<br />a medida</h1>
        <p class="hero-description">
          No improviso. Analizo tu negocio y a tu competencia para darte la web que necesitas.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="mailto:hola@diegoamorin.com">
            Cuéntame tu proyecto <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href="/proyectos/">
            Ver proyectos <ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-grid-lines" aria-hidden="true"></div>
        <div class="hero-image-frame">
          <Image
            src={heroImage}
            alt="Diego Amorin, desarrollador web"
            widths={[640, 960, 1280]}
            sizes="(min-width: 900px) 46vw, 100vw"
            loading="eager"
          />
          <span class="hero-caption">Lima, Perú <span>GMT−5</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-section" aria-labelledby="brands-title">
    <div class="container">
      <p id="brands-title" class="brand-label">He creado webs para marcas de distintos países</p>
      <div class="brand-grid">
        {brands.map((brand) => {
          const BrandLogo = brand.logo;

          return (
            <div class="brand-item">
              <BrandLogo class="brand-logo" role="img" aria-label={brand.name} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="about-image-wrap">
          <Image
            src={aboutImage}
            alt="Retrato de Diego Amorin"
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 38vw, 100vw"
            loading="lazy"
          />
        </div>
        <p class="image-note">Desarrollador web freelance</p>
      </div>
      <div class="about-copy">
        <!-- <p class="eyebrow">Sobre mí</p> -->
        <h2>Más de 5 años de experiencia</h2>
        <div>
          <p class="lead">
            Soy Diego Amorin, desarrollador web de Perú. Colaboro con marcas de España, Perú,
            México y Chile para convertir ideas y necesidades de negocio en productos digitales claros.
          </p>
          <p class="lead">
            Cuento con más de 5 años de experiencia creando sitios con WordPress, Astro, Next.js y
            NestJS. Me interesa que cada decisión visual y técnica tenga una razón: comunicar mejor,
            cargar rápido y facilitar el siguiente paso del usuario.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bordered" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <!-- <p class="eyebrow">Trabajo reciente</p> -->
          <h2 id="projects-title">Proyectos seleccionados</h2>
        </div>
        <a class="text-link" href="/proyectos/">Ver todos <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="project-grid home-project-grid">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section testimonials-section" aria-labelledby="testimonials-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <!-- <p class="eyebrow eyebrow-light">Confianza</p> -->
          <h2 id="testimonials-title">Ellos confiaron en mí.</h2>
        </div>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((testimonial) => (
          <figure class="testimonial-card">
            <blockquote>“{testimonial.quote}”</blockquote>
            <figcaption>
              <Image src={testimonial.image} alt="" width={48} height={48} loading="lazy" />
              <span><strong>{testimonial.name}</strong><small>{testimonial.role}</small></span>
              <a href={`/proyecto/${testimonial.projectSlug}/`} aria-label={`Ver proyecto relacionado con ${testimonial.name}`}>
                <ArrowUpRight size={17} aria-hidden="true" />
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="articles-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <!-- <p class="eyebrow">Desde el blog</p> -->
          <h2 id="articles-title">Artículos de desarrollo web</h2>
        </div>
        <a class="text-link" href="/blog/">Ver el blog <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="article-grid">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: calc(100svh - var(--header-height));
    padding-top: clamp(3rem, 7vw, 6.5rem);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    min-height: calc(100svh - var(--header-height) - 10rem);
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.82fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    max-width: 750px;
    margin: 0;
    font-size: clamp(3.8rem, 7.6vw, 7.25rem);
    font-weight: 650;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }

  .hero-description {
    max-width: 590px;
    margin: 2.25rem 0 0;
    color: #4e4e4e;
    font-size: clamp(1.05rem, 1.6vw, 1.28rem);
    letter-spacing: -0.02em;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero-visual {
    position: relative;
    align-self: stretch;
  }

  .hero-grid-lines {
    position: absolute;
    inset: -8rem -30vw -8rem -4rem;
    border-left: 1px solid var(--border);
    background-image: linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    opacity: 0.55;
  }

  .hero-image-frame {
    position: relative;
    top: 50%;
    overflow: hidden;
    width: min(100%, 480px);
    margin-inline: auto;
    border: 1px solid #d9d9d9;
    border-radius: 16px;
    background: #efefef;
    box-shadow: 0 35px 80px rgba(0, 0, 0, 0.16);
    transform: translateY(-50%) rotate(1.5deg);
  }

  .hero-image-frame img {
    width: 100%;
    height: auto;
    filter: saturate(0.82) contrast(1.03);
  }

  .hero-caption {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.52);
    color: #fff;
    font-size: 0.72rem;
    backdrop-filter: blur(10px);
  }

  /* Brands */
  .brand-section {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .brand-label {
    margin: 0;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }

  .brand-item {
    display: grid;
    min-height: 112px;
    place-items: center;
    padding: 1.5rem;
    border-right: 1px solid var(--border);
  }

  .brand-item:last-child {
    border-right: 0;
  }

  :global(.brand-logo) {
    color: var(--muted);
    width: auto;
    max-width: 112px;
    max-height: 34px;
    transition: color 180ms ease;
  }

  :global(.brand-logo [fill]:not([fill='none'])) {
    fill: currentColor;
  }

  :global(.brand-logo [stroke]:not([stroke='none'])) {
    stroke: currentColor;
  }

  .brand-item:hover :global(.brand-logo) {
    color: var(--foreground);
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .about-visual {
    position: relative;
  }

  .about-image-wrap {
    overflow: hidden;
    border-radius: var(--radius);
    background: #efefef;
  }

  .about-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    transition: filter 300ms ease;
  }

  .image-note {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    margin: 0;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #fff;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .about-copy h2,
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .about-copy .lead {
    color: #4e4e4e;
    font-size: clamp(1.05rem, 1.6vw, 1.28rem);
    letter-spacing: -0.025em;
    line-height: 1.5;
  }

  .about-copy > p:not(.eyebrow, .lead) {
    max-width: 650px;
    margin: 0;
    color: var(--muted);
  }

  /* Headings and grids */
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .project-grid,
  .article-grid {
    display: grid;
    gap: 1.25rem;
  }

  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .home-project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Testimonials */
  .testimonials-section {
    background: #0a0a0a;
    color: #fff;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius);
    background: var(--border-dark);
  }

  .testimonial-card {
    display: flex;
    min-height: 340px;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding: clamp(1.6rem, 4vw, 3rem);
    background: #111;
  }

  .testimonial-card blockquote {
    margin: 0;
    color: #dedede;
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    letter-spacing: -0.025em;
    line-height: 1.45;
  }

  .testimonial-card figcaption {
    display: grid;
    grid-template-columns: 48px 1fr 44px;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2.5rem;
  }

  .testimonial-card figcaption img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonial-card figcaption span,
  .testimonial-card figcaption strong,
  .testimonial-card figcaption small {
    display: block;
  }

  .testimonial-card figcaption strong {
    font-size: 0.85rem;
  }

  .testimonial-card figcaption small {
    margin-top: 0.15rem;
    color: #818181;
    font-size: 0.74rem;
  }

  .testimonial-card figcaption > a {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid #333;
    border-radius: 50%;
    color: #aaa;
  }

  .testimonial-card figcaption > a:hover {
    border-color: #777;
    color: #fff;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.75fr);
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: clamp(3.5rem, 7.5vw, 5.2rem);
    }

    .brand-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .brand-item:nth-child(3) {
      border-right: 0;
    }

    .brand-item:nth-child(-n + 3) {
      border-bottom: 1px solid var(--border);
    }

    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding-top: 4rem;
    }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero h1 {
      font-size: clamp(3.25rem, 15vw, 5rem);
    }

    .hero-description {
      font-size: 1.05rem;
    }

    .hero-visual {
      min-height: 520px;
    }

    .hero-image-frame {
      width: min(88%, 430px);
    }

    .hero-grid-lines {
      inset: -3rem -2rem;
      border: 0;
    }

    .brand-item {
      min-height: 92px;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .about-visual {
      width: min(100%, 520px);
    }

    .section-heading {
      align-items: flex-start;
    }

    .home-project-grid,
    .project-grid,
    .article-grid,
    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    .home-project-grid .project-card:first-child {
      grid-column: auto;
      grid-row: auto;
    }

    .home-project-grid .project-card:first-child :global(.card-media) {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .testimonial-grid {
      gap: 1px;
    }

    .testimonial-card {
      min-height: 300px;
    }
  }

  @media (max-width: 520px) {
    .brand-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .brand-item,
    .brand-item:nth-child(3) {
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .brand-item:nth-child(even) {
      border-right: 0;
    }

    .brand-item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .section-heading {
      display: block;
    }

    .section-heading > .text-link {
      margin-top: 1.25rem;
    }
  }
</style>
