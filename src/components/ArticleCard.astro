---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['content-card', 'article-card', { featured }]}>
  <a class="card-media" href={`/${post.id}/`} tabindex="-1" aria-hidden="true">
    {post.data.featuredImage ? (
      <Image
        src={post.data.featuredImage}
        alt={post.data.featuredImageAlt}
        widths={[480, 768, 1100]}
        sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
        loading="lazy"
      />
    ) : (
      <span class="media-placeholder" aria-hidden="true">DA</span>
    )}
  </a>
  <div class="card-body">
    <div class="card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span>{post.data.readingTime} min</span>
    </div>
    <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <a class="text-link" href={`/${post.id}/`}>Leer artículo <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
</article>
