---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    min-width: 0;
    color: #242424;
    font-size: clamp(1rem, 1.2vw, 1.08rem);
    line-height: 1.78;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  /* El offset de los enlaces ancla ya se define con scroll-padding en global.css. */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: #111;
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.18;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: clamp(1.75rem, 3vw, 2.3rem);
  }

  .prose :global(h3) {
    margin: 2.6rem 0 1rem;
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
  }

  .prose :global(h4) {
    margin: 2rem 0 0.8rem;
    font-size: 1.2rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(table),
  .prose :global(pre) {
    margin-block: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35rem;
  }

  .prose :global(li + li) {
    margin-top: 0.45rem;
  }

  .prose :global(a:not(.author-card a)) {
    color: #005fc1;
    text-decoration: underline;
    text-decoration-color: #a9ccec;
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    max-width: 100%;
    margin: 2rem auto;
    border: 1px solid var(--border);
    border-radius: 9px;
  }

  .prose :global(em:has(> img)) {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .prose :global(blockquote) {
    padding: 0.25rem 0 0.25rem 1.3rem;
    border-left: 3px solid #111;
    color: #4d4d4d;
    font-size: 1.12em;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(code:not(pre code)) {
    padding: 0.12em 0.35em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #f7f7f7;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.87em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1.2rem;
    border: 1px solid #2a2a2a;
    border-radius: 9px;
    font-size: 0.83rem;
    line-height: 1.65;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 130px;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--surface);
  }

  .prose :global(.video-embed) {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-block: 2rem;
    border-radius: 9px;
    background: #111;
  }

  .prose :global(.video-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .prose :global(.article-video) {
    width: 100%;
    margin-block: 2rem;
    border-radius: 9px;
    background: #111;
  }
</style>
