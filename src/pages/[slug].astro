---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Prose from '../components/Prose.astro';
import aboutImage from '../assets/site/diego-about.jpg';
import { formatDate } from '../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = new URL(`/${post.id}/`, Astro.site).toString();
const imageUrl = post.data.featuredImage
  ? new URL(post.data.featuredImage.src, Astro.site).toString()
  : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  mainEntityOfPage: canonical,
  ...(imageUrl ? { image: imageUrl } : {}),
  author: { '@type': 'Person', name: 'Diego Amorin', url: 'https://diegoamorin.com/' },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/${post.id}/`}
  image={post.data.featuredImage}
  imageAlt={post.data.featuredImageAlt}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  structuredData={structuredData}
>
  <article>
    <header class="article-header section">
      <div class="article-title container-narrow">
        <a class="back-link" href="/blog/"><ArrowLeft size={16} aria-hidden="true" /> Volver al blog</a>
        <div class="article-categories">
          {post.data.categories.map((category) => <span>{category}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          {post.data.updatedAt > post.data.publishedAt && (
            <span>Actualizado {formatDate(post.data.updatedAt, { day: undefined })}</span>
          )}
        </div>
      </div>
    </header>
    <div class="article-layout container-wide">
      <TableOfContents headings={headings} />
      <Prose>
        {post.data.featuredImage && (
          <div class="article-cover">
            <Image
              src={post.data.featuredImage}
              alt={post.data.featuredImageAlt}
              widths={[480, 768, 1200]}
              sizes="(min-width: 980px) 720px, 100vw"
              loading="eager"
              data-prose-image="false"
            />
          </div>
        )}
        <Content />
        <aside class="author-card">
          <Image src={aboutImage} alt="Diego Amorin" width={64} height={64} loading="lazy" />
          <div>
            <strong>Diego Amorin</strong>
            <p>Desarrollador web de Perú. Escribo sobre código, diseño y productos digitales.</p>
          </div>
          <a href="mailto:hola@diegoamorin.com">Contactar</a>
        </aside>
      </Prose>
    </div>
  </article>
</BaseLayout>

<style>
  /* Article */
  .article-header {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: 0;
  }

  .article-title {
    text-align: center;
  }

  .article-title .back-link {
    margin-inline: auto;
  }

  .article-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .article-categories span {
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.7rem;
  }

  .article-title h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .article-title > p {
    max-width: 680px;
    margin: 1.6rem auto 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.6rem;
    color: #858585;
    font-size: 0.76rem;
  }

  .article-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .article-cover {
    overflow: hidden;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, var(--container-narrow)) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .author-card {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 1rem;
    margin-top: 5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface);
  }

  .author-card img {
    width: 64px;
    height: 64px;
    margin: 0;
    border: 0;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .author-card strong {
    color: #111;
    font-size: 0.9rem;
  }

  .author-card p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .author-card a {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: minmax(170px, 220px) minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .article-layout {
      display: block;
    }

    .author-card {
      grid-template-columns: 52px 1fr;
    }

    .author-card img {
      width: 52px;
      height: 52px;
    }

    .author-card a {
      grid-column: 1 / -1;
      text-align: center;
    }
  }

  @media (max-width: 520px) {
    .article-title {
      text-align: left;
    }

    .article-title .back-link {
      margin-inline: 0;
    }

    .article-categories,
    .article-meta {
      justify-content: flex-start;
    }
  }
</style>
