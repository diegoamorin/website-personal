---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Prose from '../components/Prose.astro';
import { formatDate } from '../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = new URL(`/${post.id}/`, Astro.site).toString();
const imageUrl = post.data.featuredImage
  ? new URL(post.data.featuredImage.src, Astro.site).toString()
  : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  mainEntityOfPage: canonical,
  ...(imageUrl ? { image: imageUrl } : {}),
  author: { '@type': 'Person', name: 'Diego Amorin', url: 'https://diegoamorin.com/' },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/${post.id}/`}
  image={post.data.featuredImage}
  imageAlt={post.data.featuredImageAlt}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  structuredData={structuredData}
>
  <article>
    <div class="article-layout container-wide">
      <TableOfContents headings={headings} />
      <div class="article-main">
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          {post.data.categories.map((category) => <span class="article-category">{category}</span>)}
          <time datetime={post.data.publishedAt.toISOString()}>Publicado: {formatDate(post.data.publishedAt)}</time>
          {post.data.updatedAt > post.data.publishedAt && (
            <span>Actualizado: {formatDate(post.data.updatedAt)}</span>
          )}
        </div>

        {post.data.featuredImage && (
            <div class="article-cover">
              <Image
                src={post.data.featuredImage}
                alt={post.data.featuredImageAlt}
                widths={[480, 768, 1200]}
                sizes="(min-width: 980px) 720px, 100vw"
                loading="eager"
                data-prose-image="false"
              />
            </div>
        )}
        <Prose>
          <Content />
        </Prose>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Article */
  .article-main > h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 0.98;
    margin-bottom: 2rem;
  }

  .article-main {
    min-width: 0;
  }

  .article-meta {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.6rem;
    margin-bottom: 2.5rem;
    color: #858585;
    font-size: 0.76rem;
  }

  .article-meta .article-category {
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
  }

  .article-meta time,
  .article-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .article-cover {
    overflow: hidden;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, var(--container-narrow)) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: minmax(170px, 220px) minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .article-layout {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .article-main > h1 {
      text-align: left;
    }

    .article-meta {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }
</style>
