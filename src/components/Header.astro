---
import { ArrowUpRight, ChevronDown, Menu, Package, X } from '@lucide/astro';
import Logo from '../assets/site/logo.svg';
import products from '../data/products.json';
import services from '../data/services.json';

const path = Astro.url.pathname;
const navItems = {
  start: [
    { href: '/', label: 'Inicio', active: path === '/' },
    { href: '/proyectos/', label: 'Proyectos', active: path.startsWith('/proyecto') },
  ],
  end: [
    { href: '/blog/', label: 'Blog', active: path === '/blog/' || (!path.startsWith('/proyecto') && path !== '/') },
  ],
};

const externalLinkProps = (url: string) =>
  /^https?:\/\//i.test(url) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<!-- Evita que los triggers se pinten como botones nativos antes de cargar el CSS externo. -->
<style is:inline>
  [data-nav-menu-trigger] {
    appearance: none;
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding-inline: 0.8rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #555;
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 520;
  }
</style>

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Diego Amorin, inicio">
      <Logo class="site-logo" aria-hidden="true" />
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {navItems.start.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}

      <div class="nav-menu" data-nav-menu>
        <button
          class="nav-menu-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="services-panel"
          data-nav-menu-trigger
        >
          Servicios <ChevronDown size={15} stroke-width={1.8} aria-hidden="true" />
        </button>
        <div class="nav-menu-panel" id="services-panel" data-nav-menu-panel hidden>
          <div class="nav-menu-card">
            <p class="nav-menu-kicker">Servicios de desarrollo web</p>
            <ul>
              {services.map((service) => (
                <li>
                  {service.enabled && service.url ? (
                    <a class="nav-menu-item" href={service.url} {...externalLinkProps(service.url)}>
                      <span class="nav-menu-icon service-icon">
                        <img class="service-icon-default" src={service.icon} alt="" width="34" height="34" />
                        <img class="service-icon-color" src={service.iconColor} alt="" width="34" height="34" />
                      </span>
                      <span class="nav-menu-item-copy">{service.name}</span>
                      <ArrowUpRight size={15} aria-hidden="true" />
                    </a>
                  ) : (
                    <span class="nav-menu-item nav-menu-disabled" aria-disabled="true">
                      <span class="nav-menu-icon service-icon">
                        <img src={service.icon} alt="" width="34" height="34" />
                      </span>
                      <span class="nav-menu-item-copy">{service.name}<small>Próximamente</small></span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      {navItems.end.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}

      <div class="nav-menu" data-nav-menu>
        <button
          class="nav-menu-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="products-panel"
          data-nav-menu-trigger
        >
          Productos <ChevronDown size={15} stroke-width={1.8} aria-hidden="true" />
        </button>
        <div class="nav-menu-panel" id="products-panel" data-nav-menu-panel hidden>
          <div class="nav-menu-card">
            <p class="nav-menu-kicker">Productos digitales</p>
            <ul>
              {products.map((product) => (
                <li>
                  {product.enabled && product.url ? (
                    <a class="nav-menu-item" href={product.url} {...externalLinkProps(product.url)}>
                      <span class="nav-menu-icon"><Package size={17} aria-hidden="true" /></span>
                      <span class="nav-menu-item-copy">{product.name}</span>
                      <ArrowUpRight size={15} aria-hidden="true" />
                    </a>
                  ) : (
                    <span class="nav-menu-item nav-menu-disabled" aria-disabled="true">
                      <span class="nav-menu-icon"><Package size={17} aria-hidden="true" /></span>
                      <span class="nav-menu-item-copy">{product.name}<small>Próximamente</small></span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <button
      class="mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú"
      data-mobile-toggle
    >
      <Menu class="menu-open-icon" size={22} aria-hidden="true" />
      <X class="menu-close-icon" size={22} aria-hidden="true" />
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Navegación móvil" data-mobile-nav hidden>
    <div class="container">
      {navItems.start.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
      <details>
        <summary>Servicios <ChevronDown size={16} aria-hidden="true" /></summary>
        <div class="mobile-menu-items">
          {services.map((service) =>
            service.enabled && service.url ? (
              <a class="mobile-menu-item" href={service.url} {...externalLinkProps(service.url)}>
                <span class="mobile-menu-item-label">
                  <span class="service-icon">
                    <img class="service-icon-default" src={service.icon} alt="" width="34" height="34" />
                    <img class="service-icon-color" src={service.iconColor} alt="" width="34" height="34" />
                  </span>
                  {service.name}
                </span>
                <ArrowUpRight size={15} aria-hidden="true" />
              </a>
            ) : (
              <span class="mobile-menu-item mobile-menu-item-disabled" aria-disabled="true">
                <span class="mobile-menu-item-label">
                  <span class="service-icon">
                    <img src={service.icon} alt="" width="34" height="34" />
                  </span>
                  <span>{service.name}<small>Próximamente</small></span>
                </span>
              </span>
            ),
          )}
        </div>
      </details>
      {navItems.end.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
      <details>
        <summary>Productos <ChevronDown size={16} aria-hidden="true" /></summary>
        <div class="mobile-menu-items">
          {products.map((product) =>
            product.enabled && product.url ? (
              <a class="mobile-menu-item" href={product.url} {...externalLinkProps(product.url)}>
                <span class="mobile-menu-item-label">
                  <span class="nav-menu-icon"><Package size={17} aria-hidden="true" /></span>
                  {product.name}
                </span>
                <ArrowUpRight size={15} aria-hidden="true" />
              </a>
            ) : (
              <span class="mobile-menu-item mobile-menu-item-disabled" aria-disabled="true">
                <span class="mobile-menu-item-label">
                  <span class="nav-menu-icon"><Package size={17} aria-hidden="true" /></span>
                  <span>{product.name}<small>Próximamente</small></span>
                </span>
              </span>
            ),
          )}
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const navMenus = [...(header?.querySelectorAll('[data-nav-menu]') ?? [])];
  const mobileToggle = header?.querySelector('[data-mobile-toggle]');
  const mobileNav = header?.querySelector('[data-mobile-nav]');

  const setMenuOpen = (menu: Element, open: boolean) => {
    const trigger = menu.querySelector('[data-nav-menu-trigger]');
    const panel = menu.querySelector('[data-nav-menu-panel]');
    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  };

  const closeOtherMenus = (currentMenu?: Element) => {
    navMenus.forEach((menu) => {
      if (menu !== currentMenu) setMenuOpen(menu, false);
    });
  };

  navMenus.forEach((menu) => {
    const trigger = menu.querySelector('[data-nav-menu-trigger]');

    trigger?.addEventListener('click', () => {
      const willOpen = trigger.getAttribute('aria-expanded') !== 'true';
      closeOtherMenus(menu);
      setMenuOpen(menu, willOpen);
    });
    menu.addEventListener('mouseenter', () => {
      closeOtherMenus(menu);
      setMenuOpen(menu, true);
    });
    menu.addEventListener('mouseleave', () => setMenuOpen(menu, false));
    menu.addEventListener('focusin', () => {
      closeOtherMenus(menu);
      setMenuOpen(menu, true);
    });
    menu.addEventListener('focusout', (event) => {
      const focusEvent = event as FocusEvent;
      if (!menu.contains(focusEvent.relatedTarget as Node | null)) setMenuOpen(menu, false);
    });
  });

  const setMobileOpen = (open: boolean) => {
    if (!(mobileToggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobileNav.hidden = !open;
    document.body.classList.toggle('menu-is-open', open);
  };

  mobileToggle?.addEventListener('click', () => {
    setMobileOpen(mobileToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (event) => {
    if (!navMenus.some((menu) => menu.contains(event.target as Node))) closeOtherMenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    const openTrigger = navMenus
      .map((menu) => menu.querySelector('[data-nav-menu-trigger]'))
      .find((trigger) => trigger?.getAttribute('aria-expanded') === 'true');
    closeOtherMenus();
    setMobileOpen(false);
    if (openTrigger instanceof HTMLButtonElement) openTrigger.focus();
  });
</script>

<style>
  :global(body.menu-is-open) {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid rgba(230, 230, 230, 0.92);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(16px) saturate(160%);
  }

  .header-inner {
    display: flex;
    height: var(--header-height);
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .site-logo {
    display: block;
    width: 100px;
    height: 34px;
    color: var(--foreground);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .desktop-nav > a,
  .nav-menu-trigger {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.3rem;
    padding-inline: 0.8rem;
    appearance: none;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #555;
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 520;
    transition: color 150ms ease, background 150ms ease;
  }

  .desktop-nav > a:hover,
  .desktop-nav > a[aria-current='page'],
  .nav-menu-trigger:hover,
  .nav-menu-trigger[aria-expanded='true'] {
    background: #f4f4f4;
    color: #111;
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu-trigger svg {
    transition: transform 160ms ease;
  }

  .nav-menu-trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nav-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    width: 330px;
    padding-top: 0.65rem;
  }

  .nav-menu-panel[hidden] {
    display: none;
  }

  .nav-menu-card {
    padding: 0.65rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.1);
  }

  .nav-menu-kicker {
    margin: 0;
    padding: 0.55rem 0.65rem 0.45rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .nav-menu-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-menu-item {
    display: grid;
    min-height: 58px;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    font-size: 0.84rem;
  }

  a.nav-menu-item:hover,
  a.nav-menu-item:focus-visible {
    background: var(--surface-strong);
  }

  .nav-menu-item-copy {
    min-width: 0;
    line-height: 1.35;
  }

  .nav-menu-disabled {
    color: #888;
  }

  .nav-menu-disabled small,
  .mobile-menu-items small {
    display: block;
    color: #aaa;
    font-size: 0.68rem;
  }

  .nav-menu-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #fff;
  }

  .service-icon {
    position: relative;
    display: inline-grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
  }

  .service-icon img {
    position: absolute;
    inset: 0;
    width: 40px;
    height: 40px;
  }

  .service-icon-color {
    opacity: 0;
    transition: opacity 160ms ease;
  }

  a.nav-menu-item:hover .service-icon-color,
  a.nav-menu-item:focus-visible .service-icon-color,
  .mobile-menu-item:hover .service-icon-color,
  .mobile-menu-item:focus-visible .service-icon-color {
    opacity: 1;
  }

  .mobile-toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 7px;
    background: transparent;
    cursor: pointer;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded='true'] .menu-open-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded='true'] .menu-close-icon {
    display: block;
  }

  .mobile-nav {
    position: fixed;
    inset: var(--header-height) 0 0;
    z-index: 90;
    overflow-y: auto;
    border-top: 1px solid var(--border);
    background: #fff;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav .container {
    display: flex;
    flex-direction: column;
    padding-block: 1rem 3rem;
  }

  .mobile-nav > .container > a,
  .mobile-nav summary {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    font-size: 1.08rem;
    font-weight: 560;
    list-style: none;
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav details[open] summary svg {
    transform: rotate(180deg);
  }

  .mobile-menu-items {
    padding: 0.5rem 0 0.5rem 1rem;
  }

  .mobile-menu-item {
    display: flex;
    min-height: 60px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .mobile-menu-item-disabled {
    color: #888;
  }

  .mobile-menu-item-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  @media (max-width: 760px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: grid;
    }
  }
</style>
