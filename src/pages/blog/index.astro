---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { sortByPublishedAt } from '../../lib/format';

const posts = sortByPublishedAt(await getCollection('blog'));
---

<BaseLayout
  title="Blog"
  description="Artículos de Diego Amorin sobre desarrollo web, diseño UX/UI, Astro, JavaScript y WordPress."
>
  <header class="page-hero section">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Blog</p>
        <h1>Ideas que ayudan a<br />crear mejores webs.</h1>
      </div>
      <p>
        Guías y notas prácticas sobre desarrollo web, UX/UI, WordPress, Astro y las decisiones
        que hay detrás de un producto digital bien construido.
      </p>
    </div>
  </header>
  <section class="section listing-section">
    <div class="container">
      <p class="listing-count">{posts.length.toString().padStart(2, '0')} artículos publicados</p>
      <div class="article-grid listing-grid">
        {posts.map((post, index) => <ArticleCard post={post} featured={index === 0} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Listing pages */
  .page-hero {
    padding-top: clamp(4rem, 10vw, 9rem);
    border-bottom: 1px solid var(--border);
    background-image: linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-position: center;
    background-size: 48px 48px;
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.6fr);
    align-items: end;
    gap: 4rem;
  }

  .page-hero h1 {
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 6.7rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.93;
  }

  .page-hero-grid > p {
    margin: 0 0 0.3rem;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .listing-section {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .listing-count {
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .listing-grid :global(.featured) {
    grid-column: span 2;
  }

  .article-grid.listing-grid :global(.featured) {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  }

  .article-grid.listing-grid :global(.featured .card-media) {
    height: 100%;
    border-right: 1px solid var(--border);
    border-bottom: 0;
  }

  .article-grid.listing-grid :global(.featured .card-body) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .article-grid.listing-grid :global(.featured .card-body h3) {
    font-size: clamp(1.7rem, 3vw, 2.65rem);
  }

  @media (max-width: 980px) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .page-hero-grid > p {
      margin: 0;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-grid.listing-grid :global(.featured) {
      display: block;
      grid-column: auto;
      grid-row: auto;
    }

    .article-grid.listing-grid :global(.featured .card-media) {
      height: auto;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
