---
import { ArrowUpRight, Mail } from '@lucide/astro';
---

<footer class="site-footer">
  <div class="container footer-cta">
    <div>
      <p class="eyebrow eyebrow-light">Hablemos</p>
      <h2>Tu negocio necesita<br />una web a su medida.</h2>
    </div>
    <a class="button button-light" href="mailto:hola@diegoamorin.com">
      <Mail size={18} aria-hidden="true" />
      hola@diegoamorin.com
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Diego Amorin</p>
    <p>Diseño y desarrollo web desde Perú.</p>
  </div>
</footer>

<style>
  /* Footer */
  .site-footer {
    background: #0a0a0a;
    color: #fff;
  }

  .footer-cta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .footer-cta h2 {
    font-size: clamp(2.7rem, 6vw, 5.5rem);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--border-dark);
    color: #858585;
    font-size: 0.72rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-cta h2 {
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.5rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  @media (max-width: 760px) {
    .footer-cta {
      align-items: flex-start;
      flex-direction: column;
      gap: 2rem;
    }
  }

  @media (max-width: 520px) {
    .footer-cta h2 {
      font-size: clamp(2.2rem, 11vw, 3rem);
    }

    .footer-cta .button {
      width: 100%;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
